# Copy to .env and fill in. Placeholders only — never commit real values.
# Values containing spaces or shell characters must be double-quoted (the deploy scripts source
# this file with bash): ADMIN_NAME="Platform Administrator", MAIL_FROM="Name <no-reply@example.com>".
NODE_ENV=development
LOG_LEVEL=info

APP_BASE_URL=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=4000
TRUST_PROXY=loopback
COOKIE_SECURE=false            # must be true in production

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=arthvex_email
DB_USER=arthvex_app
DB_PASSWORD=change-me

APP_ENCRYPTION_KEY=            # openssl rand -base64 32
SESSION_SECRET=                # openssl rand -base64 48
ADMIN_MFA_REQUIRED=true

# Platform administrator (separate principal/table from customer users).
# Seed or update with: npm run admin:create
ADMIN_EMAIL=admin@example.invalid
ADMIN_NAME="Platform Administrator"
ADMIN_ROLE=super_admin
ADMIN_PASSWORD=          # leave empty to be prompted; set only for non-interactive provisioning

# dev = simulation only (refused in production). stalwart = real engine.
# The Stalwart management credential must hold sysApiKey* and impersonate so the control plane can
# create a mailbox-scoped API key for webmail. It is never sent to a browser.
MAIL_ADAPTER=dev
STALWART_URL=
STALWART_ADMIN_USER=
STALWART_ADMIN_SECRET=
STALWART_TIMEOUT_MS=10000

MAIL_HOSTNAME=mail.example.invalid   # real public mail hostname in production
MAIL_PUBLIC_IPV4=
MAIL_PUBLIC_IPV6=
ALLOW_TEST_DOMAINS=false

# dev = writes to a local file outbox (refused in production)
MAILER=dev
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ARTHVEX <no-reply@localhost>"

DNS_RESOLVERS=

# Paths are relative to the backend working directory.
DEV_MAIL_ENGINE_STATE=./var/dev-mail-engine/state.json
DEV_OUTBOX_DIR=./var/dev-outbox
DEV_WEBMAIL_STATE=./var/dev-webmail/state.json

# --- optional tuning (defaults shown) ---
# RATE_LIMIT_ENABLED=true
# ADMIN_MFA_REQUIRED=true
# SESSION_TTL_HOURS=168
# SESSION_IDLE_HOURS=24
# IMAP_PORT=993
# SUBMISSION_PORT=465
# SUBMISSION_STARTTLS_PORT=
# JMAP_URL=
# WEBMAIL_URL=
# WORKER_CONCURRENCY=2
# DOMAIN_VERIFICATION_TTL_DAYS=14
# --- webmail (defaults shown) ---
# WEBMAIL_ENABLED=true
# WEBMAIL_JMAP_URL=            # defaults to STALWART_URL
# WEBMAIL_MAX_ATTACHMENT_BYTES=10485760
# WEBMAIL_MAX_ATTACHMENTS=10
# WEBMAIL_BODY_MAX_CHARS=400000
# ADMIN_ACCESS_GRANT_TTL_MINUTES=60
