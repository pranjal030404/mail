{
  "name": "@arthvex/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "start:worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts up",
    "db:rollback": "tsx --env-file-if-exists=.env src/db/migrate.ts down",
    "db:seed:dev": "tsx --env-file-if-exists=.env src/db/seed-dev.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.7",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2"
  }
}
