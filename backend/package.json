{
  "name": "arthvex-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bash scripts/dev-db.sh start",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "predev:worker": "bash scripts/dev-db.sh start",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "db:start": "bash scripts/dev-db.sh start",
    "db:stop": "bash scripts/dev-db.sh stop",
    "db:status": "bash scripts/dev-db.sh status",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "start:worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts up",
    "db:rollback": "tsx --env-file-if-exists=.env src/db/migrate.ts down",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.7",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
