# /etc/systemd/system/arthvex-api.service
# Runs the Fastify API as an unprivileged user. The environment file must be 0600.
[Unit]
Description=ARTHVEX Mail API
After=network-online.target mysql.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=arthvex
Group=arthvex
WorkingDirectory=/srv/arthvex/backend
EnvironmentFile=/etc/arthvex/backend.env
ExecStart=/usr/bin/node --enable-source-maps /srv/arthvex/backend/node_modules/tsx/dist/cli.mjs src/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/arthvex/backend/var
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=2G
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=arthvex-api

[Install]
WantedBy=multi-user.target
