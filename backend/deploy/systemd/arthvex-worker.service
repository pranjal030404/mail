# /etc/systemd/system/arthvex-worker.service
[Unit]
Description=ARTHVEX Mail background worker
After=network-online.target mysql.service mariadb.service arthvex-api.service
Wants=network-online.target

[Service]
Type=simple
User=arthvex
Group=arthvex
WorkingDirectory=/srv/arthvex/backend
EnvironmentFile=/etc/arthvex/backend.env
ExecStart=/usr/bin/node --enable-source-maps /srv/arthvex/backend/node_modules/tsx/dist/cli.mjs src/worker/index.ts
Restart=always
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/arthvex/backend/var
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=2G
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=arthvex-worker

[Install]
WantedBy=multi-user.target
