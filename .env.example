# ARTHVEX Mail — deployment environment template.
# The application reads backend/.env (or EnvironmentFile=/etc/arthvex/backend.env in systemd).
# Copy this file to backend/.env for a local production-like run, or to /etc/arthvex/backend.env
# on a host. Placeholders only — never commit real values. See backend/.env.example for the
# development-oriented template.
NODE_ENV=production
LOG_LEVEL=info

APP_BASE_URL=https://mail.example.com
API_HOST=127.0.0.1
API_PORT=4000
TRUST_PROXY=loopback
COOKIE_SECURE=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=arthvex_email
DB_USER=arthvex_app
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# openssl rand -base64 32 / openssl rand -base64 48
APP_ENCRYPTION_KEY=
SESSION_SECRET=
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
ADMIN_MFA_REQUIRED=true

# Platform administrator (separate principal from customers). Seed with npm run admin:create.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Platform Administrator
ADMIN_ROLE=super_admin
ADMIN_PASSWORD=change-me-to-a-long-unique-password

# Real mail engine only in production. The management credential needs impersonate + sysApiKey*.
MAIL_ADAPTER=stalwart
STALWART_URL=https://127.0.0.1:8080
STALWART_ADMIN_USER=admin
STALWART_ADMIN_SECRET=change-me
STALWART_TIMEOUT_MS=10000

MAIL_HOSTNAME=mail.example.com
MAIL_PUBLIC_IPV4=203.0.113.10
MAIL_PUBLIC_IPV6=
IMAP_PORT=993
SUBMISSION_PORT=465
JMAP_URL=https://mail.example.com/jmap/
WEBMAIL_URL=
RESERVED_DOMAINS=
ALLOW_TEST_DOMAINS=false

WEBMAIL_ENABLED=true
WEBMAIL_JMAP_URL=https://127.0.0.1:8080
WEBMAIL_MAX_ATTACHMENT_BYTES=10485760
WEBMAIL_MAX_ATTACHMENTS=10
WEBMAIL_BODY_MAX_CHARS=400000

ADMIN_ACCESS_GRANT_TTL_MINUTES=60

MAILER=smtp
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@example.com
SMTP_PASSWORD=change-me
MAIL_FROM=ARTHVEX <no-reply@example.com>

DNS_RESOLVERS=
DNS_TIMEOUT_MS=4000
DOMAIN_VERIFICATION_TTL_DAYS=14

WORKER_POLL_MS=2000
WORKER_LEASE_SECONDS=120
WORKER_CONCURRENCY=2
BACKUP_MAX_AGE_HOURS=26

# Development-only paths (unused in production).
DEV_MAIL_ENGINE_STATE=./var/dev-mail-engine/state.json
DEV_OUTBOX_DIR=./var/dev-outbox
DEV_WEBMAIL_STATE=./var/dev-webmail/state.json
